/*
 * Design Vault, a mod for Warzone 2100 4.4.x skirmish and multiplayer games.
 *
 * The designs listed below are also defined as built-in designs by this mod's stats/templates.json, which is how the game
 * offers them as soon as every component of them has been researched. What this script adds is the "replaces" relation:
 * as soon as a design that replaces another one can be built, the older one is taken out of the design and factory lists
 * for the rest of the game. A game where the newer design cannot be built yet still offers the older one.
 *
 * This file is generated by mod\build-mod.ps1 from your saved designs. Do not edit it, edit mod\lines.txt instead.
 */

var DV_DESIGNS = /*DV_DATA*/[];

var dvHidden = {};

function dvLog(text)
{
	dump("[design vault] " + text);
}

function dvAvailable(design)
{
	for (var i = 0; i < design.parts.length; ++i)
	{
		if (!componentAvailable(design.parts[i]))
		{
			return false;
		}
	}
	return true;
}

// Takes every design out of the lists that a design which can be built replaces, one step or several steps down its line.
function dvUpdate()
{
	var byId = {};
	for (var i = 0; i < DV_DESIGNS.length; ++i)
	{
		byId[DV_DESIGNS[i].id] = DV_DESIGNS[i];
	}
	for (var j = 0; j < DV_DESIGNS.length; ++j)
	{
		var newest = DV_DESIGNS[j];
		if (!newest.replaces || !dvAvailable(newest))
		{
			continue;
		}
		var seen = {};
		seen[newest.id] = true;
		var older = byId[newest.replaces];
		while (older && !seen[older.id])
		{
			seen[older.id] = true;
			if (!dvHidden[older.id])
			{
				dvHidden[older.id] = true;
				var removed = removeTemplate(older.id);
				dvLog("\"" + older.name + "\" is replaced by \"" + newest.name + "\", which can be built now (" + (removed ? "hidden" : "was not in the lists") + ")");
			}
			older = older.replaces ? byId[older.replaces] : null;
		}
	}
}

function dvStart()
{
	removeTimer("dvUpdate"); // the same timer may come back with a saved game
	setTimer("dvUpdate", 1000);
	dvUpdate();
	dvLog("watching " + DV_DESIGNS.length + " saved designs");
	console("Design Vault: " + DV_DESIGNS.length + " saved designs");
}

// This file is included after the rules of the game, which already define these two events, so they are extended and not replaced.
var dvPreviousGameInit = (typeof eventGameInit === "function") ? eventGameInit : null;
eventGameInit = function()
{
	if (dvPreviousGameInit)
	{
		dvPreviousGameInit.apply(this, arguments);
	}
	dvStart();
};

var dvPreviousGameLoaded = (typeof eventGameLoaded === "function") ? eventGameLoaded : null;
eventGameLoaded = function()
{
	if (dvPreviousGameLoaded)
	{
		dvPreviousGameLoaded.apply(this, arguments);
	}
	dvStart();
};
